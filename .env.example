# Copy this file to .env and fill in your API credentials.

# Set one API key. COREAGENT_API_KEY takes precedence over provider-specific keys.
COREAGENT_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# Leave the base URL empty for the default OpenAI endpoint.
COREAGENT_BASE_URL=
COREAGENT_MODEL=gpt-5.6-luna
COREAGENT_MAX_TOKENS=4096
COREAGENT_TEMPERATURE=0
COREAGENT_MAX_CONTEXT=128000
COREAGENT_PROVIDER=openai
